# AITuneCreator Environment Configuration
# This file is a template for setting up environment variables
# Copy this file to create environment-specific files:
#   - .env.dev for development
#   - .env.test for testing
#   - .env.prod for production
#
# Then fill in the values for your environment

# ===== REQUIRED SETTINGS =====

# Environment type: dev, test, or prod
ENVIRONMENT=dev

# Groq API Key (get from https://console.groq.com)
# For development: Use your personal dev API key
# For testing: Use a test/mock key if available
# For production: Use the production API key
GROQ_API_KEY=

# ===== OPTIONAL SETTINGS =====

# Streamlit server port
STREAMLIT_SERVER_PORT=8501

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Enable response caching (useful for testing to reduce API calls)
ENABLE_CACHING=false
